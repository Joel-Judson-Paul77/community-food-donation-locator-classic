# Port the API listens on
PORT=5000

# MongoDB connection string. Leave empty to use a temporary in-memory
# database that is seeded with demo data on every start.
# Local:  mongodb://127.0.0.1:27017/foodshare
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/foodshare
MONGO_URI=

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Allowed browser origin(s) for CORS, comma separated
CLIENT_URL=http://localhost:5173
